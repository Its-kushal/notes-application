{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@notes/core": [
        "../../packages/core/src/index.ts"
      ],
      "@notes/ui": [
        "../../packages/ui/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "app/**/*"
  ],
  "extends": "expo/tsconfig.base"
}
